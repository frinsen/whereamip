/* WhereAmIP — English UI strings.

   This file is the ONE place to retune user-facing wording; keys are declared in
   Sources/WhereAmIPUI/L10n.swift and every call site goes through L10n.string(_:).
   A `de.lproj/Localizable.strings` next to this one is all a translation needs.

   Rules that are not free to change:
     - keys are stable; renaming one is a code change, not a text change
     - %@ / %d placeholders keep their order and count (String(format:) fills them
       positionally); reordering needs %1$@-style positional specifiers
     - leading/trailing spaces in the fragment values (dns.row.*, menu.privateRelay.via,
       notification.dns.body.egress) are intentional — those are appended to a line

   NOT here: `whereamip` CLI output, JSON keys, log messages. Those are a parseable
   API, not copy.
*/

/* MARK: - menu */

"menu.header" = "WhereAmIP v%@";
"menu.update.restart" = "↻ Restart to finish update (v%@)";
/* The row copies the upgrade command; it deliberately does NOT spell it out. The real
   command depends on how this copy was installed (UpdateChecker.upgradeCommand(for:)), and
   printing it in the row made it the widest thing in the dropdown by ~100pt. Naming no
   command at all cannot contradict the clipboard, which is what the previous label did by
   naming an incomplete one — and cannot go stale when a fourth channel appears. */
"menu.update.available" = "⬆︎ Update v%@ available — copy the update command";
/* Same row, for a copy no package manager installed (the release zip, a dist/ build):
   there is no command to copy, so the click opens the releases page instead and the label
   has to say so — a row that promises a command the clipboard does not carry is the same
   mistake as naming an incomplete one. Kept no wider than the row above (measured in
   L10nTests): this is the dropdown's first and widest row. */
"menu.update.available.download" = "⬆︎ Update v%@ available — open the download page";
"menu.offline" = "No internet connection";
"menu.offline.hijack" = "⚠️ OpenVPN hijack routes present — tunnel likely dead";
/* %1 timestamp, %2 country flag emoji (may be empty), %3 organisation (may be empty) */
"menu.offline.lastSeen" = "Last seen online: %@ via %@ %@";
/* %1 organisation, %2 ISO country code */
"menu.leak.ipv6" = "⚠️ IPv6 leak — v6 exits via %@ (%@)";
"menu.leak.dns" = "⚠️ DNS leak — queries answered via %@";
/* %1 resolver operator, %2 egress IP */
"menu.leak.dns.withOperator" = "⚠️ DNS leak — queries answered via %@ (%@)";
"menu.leak.dns.suspected" = "DNS leak suspected — resolver exits outside the tunnel";
"menu.since" = "Since %@";
"menu.checked" = "Checked: %@";
/* %1 VPN name, %2 interface */
"menu.route.vpn" = "VPN: %@ (%@) owns default route";
/* Shown when the tunnel owns the route but no name could be established — the honest
   generic, NOT "unknown", which reads as a malfunction. This is what every user whose
   VPN we have no fingerprint for sees, so it must read as a plain fact. %1 interface */
"menu.route.vpn.unnamed" = "VPN (%@) owns default route";
/* %1 link kind (Wi-Fi/Ethernet/…), %2 interface */
"menu.route.link" = "Route: %@ (%@)";
/* %1 the "menu.privateRelay.via" fragment, or empty when the relay country is unknown */
"menu.privateRelay" = "Private Relay: ON — Safari exits%@ elsewhere";
"menu.privateRelay.via" = " via %@";
"menu.org.unknown" = "your ISP";
/* ⌥⌘C alternate of the exit-IP row: copies BOTH exit addresses, so the label must
   promise exactly two — the row is hidden entirely when there is no IPv6 exit */
"menu.copyExitBoth" = "Copy both exit addresses";
/* Takes the same ⌥-hold slot when there is no IPv6 exit, as a DISABLED row: holding ⌥
   must always answer, either with the wider copy or with the reason it is unavailable.
   "No X" mirrors the menu's own "No internet connection"; the trailing "to copy" keeps
   it tied to the action whose place it is taking, which a bare network fact would not. */
"menu.copyExitBoth.unavailable" = "No IPv6 exit to copy";
"menu.copyDiagnostics" = "Copy Diagnostics";
"menu.refresh" = "Refresh";
/* Apple's HIG naming pattern for a Help item, "<YourAppName> Help" — this app is
   LSUIElement, so there is no real menu bar and no Help menu; this row stands in */
"menu.help" = "WhereAmIP Help";
"menu.settings" = "Settings";
"menu.restart" = "Restart WhereAmIP";
"menu.quit" = "Quit WhereAmIP";

/* MARK: - settings (also the welcome window's checkbox labels) */

"settings.style" = "Menu Bar Style";
"settings.style.emoji" = "Emoji flag";
"settings.style.code" = "ISO country code";
"settings.style.image" = "Flag image";
/* The in-app language override. Sits next to the menu-bar style because both are
   "how this app looks to me" choices, and both are radio pickers. */
"settings.language" = "Language";
/* Follow the Mac's own language setting — the default. Named the way macOS names it in
   its own per-app language picker rather than a literal "System default". */
"settings.language.system" = "System Language";
/* Each language names ITSELF, identically in every locale: a German speaker looking for
   German finds "Deutsch" even while the UI is still English, which is the whole point of
   the row. These two values are deliberately the same in en.lproj and de.lproj. */
"settings.language.english" = "English";
"settings.language.german" = "Deutsch";
"settings.notifications" = "Show Notifications";
"settings.launchAtLogin" = "Launch at Login";
"settings.applicationsLink" = "Add to Applications folder";
"settings.updates" = "Check for Updates";
"settings.dnsProbe" = "Check for DNS Leaks";
"settings.welcome" = "Show Welcome Window";
/* The milestone highlights, on demand. A noun phrase among verb phrases on purpose:
   it names a thing everyone already knows by that name (Apple's own App Store section
   header), and "Show What's New" would be a mouthful for the same click. */
"settings.whatsNew" = "Show What's New";

/* MARK: - dns */

"dns.row" = "DNS: %@";
"dns.row.interface" = " via %@";
"dns.row.doh" = " · DoH";
"dns.row.dot" = " · DoT";
"dns.row.plaintext" = " · plaintext";
"dns.row.more" = "  (+%d more)";
"dns.section.configured" = "Configured resolvers";
"dns.section.egress" = "Queries answered by";
/* %1 resolver address, %2 comma-separated interfaces it is scoped to */
"dns.resolver.interfaces" = "%@ — %@";
"dns.disabled" = "DNS check disabled";
"dns.forwarder" = "Router forwards to %@ — encryption of that hop is set on the router";
/* The two bulk-copy rows at the foot of the DNS submenu. Each names WHICH of the
   two sections above it copies, echoing that section's own heading:
   "Configured resolvers" → configured, "Queries answered by" → answering. The
   clipboard payload is bare addresses, one per line — never the row's own text. */
"dns.copy.configured" = "Copy configured resolvers";
"dns.copy.answering" = "Copy answering resolvers";

