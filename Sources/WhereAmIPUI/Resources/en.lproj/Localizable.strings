"notification.countryChanged.body" = "Exit country changed";
"notification.countryChanged.body.vpn" = "%@ took over the default route";
"notification.ipChanged.title" = "New exit IP in %@";
"notification.offline.title" = "Internet unreachable";
"notification.offline.body" = "Network is up, probes failing";
"notification.offline.body.hijack" = "OpenVPN hijack routes present — tunnel likely dead";
/* %1 country flag, %2 city (may be empty) */
"notification.online.title" = "Back online: %@ %@";
"notification.leak.title" = "⚠️ Possible VPN leak";
"notification.leak.body" = "VPN route active but traffic still exits via %@";
"notification.relay.on.title" = "Private Relay ON";
