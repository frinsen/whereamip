"menu.checked" = "Checked: %@";
/* %1 VPN name, %2 interface */
"menu.route.vpn" = "VPN: %@ (%@) owns default route";
/* Shown when the tunnel owns the route but no name could be established — the honest
   generic, NOT "unknown", which reads as a malfunction. This is what every user whose
