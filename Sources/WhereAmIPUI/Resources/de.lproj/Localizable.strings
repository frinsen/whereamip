"dns.row.doh" = " · DoH";
"dns.row.dot" = " · DoT";
"dns.row.plaintext" = " · unverschlüsselt";
"dns.row.more" = "  (+%d weitere)";
"dns.section.configured" = "Konfigurierte Resolver";
"dns.section.egress" = "Anfragen beantwortet von";
/* %1 Resolver-Adresse, %2 Schnittstellen (kommagetrennt), denen sie zugeordnet ist */
"dns.resolver.interfaces" = "%@ — %@";
"dns.disabled" = "DNS-Prüfung deaktiviert";
"dns.forwarder" = "Router leitet an %@ weiter — ob dieser Abschnitt verschlüsselt ist, wird am Router eingestellt";
/* Die beiden Kopierzeilen am Ende des DNS-Untermenüs. Jede benennt, WELCHE der beiden
   Listen darüber sie kopiert, im Vokabular der jeweiligen Überschrift. */
"dns.copy.configured" = "Konfigurierte Resolver kopieren";
"dns.copy.answering" = "Antwortende Resolver kopieren";

