/* WhereAmIP — deutsche UI-Texte.

   Schwesterdatei zu en.lproj/Localizable.strings; die Schlüssel sind in
   Sources/WhereAmIPUI/L10n.swift deklariert. macOS wählt diese Datei automatisch,
   sobald die Systemsprache Deutsch ist — im Code ist dafür nichts zu tun.

   Regeln, die nicht frei änderbar sind:
     - Schlüssel sind stabil; einen Schlüssel umzubenennen ist eine Code-Änderung
     - %@ / %d behalten Anzahl UND Reihenfolge aus en.lproj (String(format:) füllt
       positionsabhängig) — ein fehlendes %@ hier wäre ein Absturz, den nur deutsche
       Nutzer sehen; L10nTests prüft die Parität
     - führende/abschließende Leerzeichen in den Fragmenten (dns.row.*,
       menu.privateRelay.via, notification.dns.body.egress) sind Absicht

   Vokabular: deutsche macOS-Systembegriffe statt wörtlicher Übersetzungen —
   „Mitteilungen" (nicht „Benachrichtigungen"), „Beenden", „Aktualisieren",
   Ordner „Programme", „Nach Updates suchen".

   NICHT hier: Ausgaben von `whereamip`, JSON-Schlüssel, Log-Meldungen. Das ist eine
   auswertbare Schnittstelle, kein UI-Text.
*/

/* MARK: - menu */

"menu.header" = "WhereAmIP v%@";
"menu.update.restart" = "↻ Zum Abschließen des Updates neu starten (v%@)";
/* Die Zeile kopiert den Befehl und nennt ihn bewusst NICHT: welcher es ist, hängt von der
   Installationsart ab (UpdateChecker.upgradeCommand(for:)), und ihn zu nennen machte die
   Zeile um rund 100 pt zur breitesten im Menü. Gar keinen Befehl zu nennen kann der
   Zwischenablage nicht widersprechen — genau das tat die alte Beschriftung, die einen
   unvollständigen nannte. Verb am Ende wie die anderen Aktionszeilen
   („Diagnose kopieren"). */
"menu.update.available" = "⬆︎ Update v%@ verfügbar — Update-Befehl kopieren";
/* Dieselbe Zeile für eine Kopie, die kein Paketmanager installiert hat (Release-ZIP,
   dist/-Build): es gibt keinen Befehl zu kopieren, der Klick öffnet die Releases-Seite —
   und die Beschriftung muss das sagen. Verb am Ende wie die Geschwisterzeilen
   („Update-Befehl kopieren", „Einstellungen öffnen"), und nicht breiter als die Zeile
   darüber (in L10nTests gemessen). */
"menu.update.available.download" = "⬆︎ Update v%@ verfügbar — Download-Seite öffnen";
"menu.offline" = "Keine Internetverbindung";
"menu.offline.hijack" = "⚠️ OpenVPN-Hijack-Routen vorhanden — Tunnel vermutlich tot";
/* %1 Zeitstempel, %2 Länderflagge (kann leer sein), %3 Betreiber (kann leer sein) */
"menu.offline.lastSeen" = "Zuletzt online: %@ über %@ %@";
/* %1 Betreiber, %2 ISO-Ländercode */
"menu.leak.ipv6" = "⚠️ IPv6-Leck — v6 tritt über %@ (%@) aus";
"menu.leak.dns" = "⚠️ DNS-Leck — Anfragen werden über %@ beantwortet";
/* %1 Resolver-Betreiber, %2 Austritts-IP */
"menu.leak.dns.withOperator" = "⚠️ DNS-Leck — Anfragen werden über %@ (%@) beantwortet";
"menu.leak.dns.suspected" = "DNS-Leck vermutet — Resolver tritt außerhalb des Tunnels aus";
"menu.since" = "Seit %@";
"menu.checked" = "Geprüft: %@";
/* %1 VPN-Name, %2 Schnittstelle */
"menu.route.vpn" = "VPN: %@ (%@) hat die Standardroute";
/* Wenn der Tunnel die Route hat, aber kein Name zu ermitteln war — bewusst nicht
   „unbekannt", das läse sich wie ein Fehler. %1 Schnittstelle */
"menu.route.vpn.unnamed" = "VPN (%@) hat die Standardroute";
/* %1 Verbindungsart (WLAN/Ethernet/…), %2 Schnittstelle */
"menu.route.link" = "Route: %@ (%@)";
/* %1 das Fragment „menu.privateRelay.via", oder leer wenn das Land unbekannt ist */
"menu.privateRelay" = "Privat-Relay: EIN — Safari tritt%@ woanders aus";
"menu.privateRelay.via" = " über %@";
"menu.org.unknown" = "deinen Internetanbieter";
/* ⌥⌘C-Alternative zur Austritts-IP-Zeile: kopiert BEIDE Adressen, der Text muss also
   genau zwei versprechen — ohne IPv6-Austritt fehlt die Zeile ganz */
"menu.copyExitBoth" = "Beide Austrittsadressen kopieren";
/* Nimmt denselben ⌥-Platz ein, wenn es keinen IPv6-Austritt gibt, als DEAKTIVIERTE
   Zeile: ⌥ muss immer antworten — entweder mit der Kopie oder mit dem Grund dafür,
   dass es keine gibt. */
"menu.copyExitBoth.unavailable" = "Keine IPv6-Adresse zum Kopieren";
"menu.copyDiagnostics" = "Diagnose kopieren";
"menu.refresh" = "Aktualisieren";
/* Apples Namensmuster für Hilfeeinträge, „<Programmname>-Hilfe" (wie „Safari-Hilfe").
   Die App ist LSUIElement, hat also keine echte Menüleiste — diese Zeile ersetzt sie. */
"menu.help" = "WhereAmIP-Hilfe";
"menu.settings" = "Einstellungen";
"menu.restart" = "WhereAmIP neu starten";
"menu.quit" = "WhereAmIP beenden";

/* MARK: - settings (zugleich die Beschriftungen im Willkommensfenster) */

"settings.style" = "Menüleistenstil";
"settings.style.emoji" = "Emoji-Flagge";
"settings.style.code" = "ISO-Ländercode";
"settings.style.image" = "Flaggenbild";
/* Die App-Sprache. Steht neben dem Menüleistenstil: beides sind „wie sieht die App für
   mich aus"-Entscheidungen, und beides sind Auswahllisten mit Häkchen. */
"settings.language" = "Sprache";
/* Der Sprache des Systems folgen — die Voreinstellung. Benannt wie macOS es in seiner
   eigenen Sprachauswahl pro Programm tut, nicht wörtlich als „Systemvorgabe". */
"settings.language.system" = "Systemsprache";
/* Jede Sprache benennt SICH SELBST, in jeder Lokalisierung gleich: wer Deutsch sucht,
   findet „Deutsch" auch dann, wenn die Oberfläche noch englisch ist. Diese beiden Werte
   sind in en.lproj und de.lproj absichtlich identisch. */
"settings.language.english" = "English";
"settings.language.german" = "Deutsch";
"settings.notifications" = "Mitteilungen anzeigen";
"settings.launchAtLogin" = "Bei der Anmeldung starten";
"settings.applicationsLink" = "Zum Ordner „Programme“ hinzufügen";
"settings.updates" = "Nach Updates suchen";
"settings.dnsProbe" = "Auf DNS-Lecks prüfen";
"settings.welcome" = "Willkommensfenster anzeigen";
/* Apple's own German for "What's New": the macOS App Store labels an app's
   what's-new section "Neue Funktionen" (AppStoreKit,
   PRODUCT_SECTION_MOST_RECENT_VERSION). Noun phrase, like the English. */
"settings.whatsNew" = "Neue Funktionen";

