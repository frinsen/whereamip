/* MARK: - welcome window (body copy lives in Resources/welcome/*.md) */

"welcome.window.title" = "WhereAmIP";
/* One heading for both variants — the category is carried by the badge above it.
   %1 is the RUNNING version for the first-run pitch and the WELCOME MILESTONE for
   the what's-new window (the release that earned the re-show, which the running
   build may already be patch releases past) — see WelcomeContent.copy(variant:) */
"welcome.heading" = "WhereAmIP v%@";
/* Category pills above the heading. Title case here, uppercased by the view */
"welcome.badge.intro" = "Getting Started";
"welcome.badge.whatsNew" = "What's New";
/* Shown in the first-run pitch only — it tells a new reader where to look for the
   flag, which is not what someone opening What's New came for */
"welcome.hint" = "Can't see the flag? A crowded menu bar may hide it behind the notch.";
/* Section header. Title case here, uppercased by the view, exactly like the badges */
"welcome.setup.header" = "Your setup";
/* Its caption: the header carries the pattern, this carries the explanation. Verb
   first and no subject, like welcome.notify.caption — the window's other caption */
"welcome.setup.caption" = "Reflects your current settings.";
/* Single line, must fit 353pt at 10pt system font without truncating — measure
   before lengthening (see WelcomeWindow.swift) */
"welcome.notify.caption" = "Alerts on exit, route, or connectivity changes. Asks macOS permission.";
"welcome.notify.hint" = "Notifications are disabled in System Settings — open Notifications settings";
"welcome.privacy" = "No tracking, no history, no logs.";
"welcome.done" = "Done";

/* MARK: - help window (body copy lives in Resources/help/help.md) */

/* Matches the dropdown row that opens it, so the window is recognisable as its result */
"help.window.title" = "WhereAmIP Help";
