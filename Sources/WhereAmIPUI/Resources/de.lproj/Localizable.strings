/* MARK: - Willkommensfenster (Fließtext liegt in Resources/welcome/de/*.md) */

"welcome.window.title" = "WhereAmIP";
/* Eine Überschrift für beide Varianten — die Kategorie steht im Badge darüber.
   %1 ist die LAUFENDE Version bei der Vorstellung und der WILLKOMMENS-MEILENSTEIN
   beim Neue-Funktionen-Fenster (die Version, für die das Fenster wieder aufgegangen
   ist; die laufende kann schon einige Patch-Releases weiter sein) */
"welcome.heading" = "WhereAmIP v%@";
/* Kategorie-Badges über der Überschrift. Hier in normaler Schreibweise, die
   Großschreibung macht die View. "Neue Funktionen" ist Apples eigene Wortwahl
   und steht wortgleich im Menü (settings.whatsNew) */
"welcome.badge.intro" = "Erste Schritte";
"welcome.badge.whatsNew" = "Neue Funktionen";
"welcome.hint" = "Flagge nicht zu sehen? In einer vollen Menüleiste verschwindet sie leicht hinter der Notch.";
"welcome.setup.header" = "Deine Einrichtung";
